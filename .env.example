# ===== LLM 配置（OpenAI 兼容） =====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120

# 通义千问
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 豆包（火山方舟）
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=<你的接入点ID>

# ===== 排盘 provider（local | thirdparty） =====
PROVIDER_BAZI=local
PROVIDER_ZIWEI=local
PROVIDER_QIMEN=local
# local 失败时是否自动降级到第三方
ALLOW_FALLBACK=true

# ===== 第三方排盘 API（可选） =====
THIRDPARTY_BASE_URL=https://aov.cc/api/v1
THIRDPARTY_API_KEY=

# ===== 紫微 Node 桥接 =====
# per_process: 每次调用 fork 一次 node；node_service: 常驻 Node 微服务（生产推荐）
ZIWEI_MODE=per_process
ZIWEI_NODE_BIN=node
ZIWEI_SCRIPT_PATH=node_ziwei/ziwei-chart.mjs

# ===== 真太阳时 =====
TRUE_SOLAR_TIME=true

# ===== 数据库（业务落库；连不上不阻塞接口） =====
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mingpan

# ===== 安全（生产必配） =====
# API_KEYS=key1,key2
